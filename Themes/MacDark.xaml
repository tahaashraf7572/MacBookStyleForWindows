<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core palette -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#CC1E1E1E"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="#FFFFFFFF"/>

    <CornerRadius x:Key="PanelRadius">18</CornerRadius>
    <CornerRadius x:Key="IconRadius">12</CornerRadius>

    <!-- Reusable rounded icon button style used by Dock/MenuBar -->
    <Style x:Key="DockIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource IconRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
