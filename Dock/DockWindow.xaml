<Window x:Class="MacBookStyleForWindows.Dock.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Border x:Name="DockSurface"
            Background="{StaticResource SurfaceBrush}"
            CornerRadius="{StaticResource PanelRadius}"
            Padding="10,8"
            Margin="0,0,0,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>

        <StackPanel x:Name="IconStrip" Orientation="Horizontal" />
    </Border>
</Window>
