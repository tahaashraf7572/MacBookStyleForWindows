<Window x:Class="MacBookStyleForWindows.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacBook Style for Windows — Settings"
        Width="620" Height="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <TabControl Margin="16">
        <TabItem Header="Appearance">
            <StackPanel Margin="12">
                <CheckBox x:Name="TransparencyCheck" Content="Enable transparency / glass effect" Margin="0,8"/>
                <CheckBox x:Name="AnimationsCheck" Content="Enable animations" Margin="0,8"/>
                <CheckBox x:Name="RoundedCornersCheck" Content="Rounded window corners (Windows 11)" Margin="0,8"/>
                <TextBlock Text="Theme" Margin="0,16,0,4" Opacity="0.7"/>
                <ComboBox x:Name="ThemeCombo" Width="240" HorizontalAlignment="Left">
                    <ComboBoxItem Content="macOS Light"/>
                    <ComboBoxItem Content="macOS Dark"/>
                    <ComboBoxItem Content="macOS Glass"/>
                    <ComboBoxItem Content="Modern MacBook"/>
                    <ComboBoxItem Content="Custom"/>
                </ComboBox>
            </StackPanel>
        </TabItem>

        <TabItem Header="Dock">
            <StackPanel Margin="12">
                <TextBlock Text="Position" Opacity="0.7" Margin="0,0,0,4"/>
                <ComboBox x:Name="DockPositionCombo" Width="200" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Bottom"/>
                    <ComboBoxItem Content="Left"/>
                    <ComboBoxItem Content="Right"/>
                </ComboBox>
                <TextBlock Text="Icon size" Opacity="0.7" Margin="0,16,0,4"/>
                <Slider x:Name="DockSizeSlider" Minimum="32" Maximum="80" Width="240" HorizontalAlignment="Left"/>
                <TextBlock Text="Magnification" Opacity="0.7" Margin="0,16,0,4"/>
                <Slider x:Name="MagnificationSlider" Minimum="1" Maximum="2.2" Width="240" HorizontalAlignment="Left"/>
                <CheckBox x:Name="AutoHideCheck" Content="Auto-hide dock" Margin="0,16,0,0"/>
            </StackPanel>
        </TabItem>

        <TabItem Header="Menu Bar">
            <StackPanel Margin="12">
                <CheckBox x:Name="MenuBarEnabledCheck" Content="Enable top menu bar" Margin="0,8"/>
                <CheckBox x:Name="ShowWifiCheck" Content="Show Wi-Fi" Margin="0,8"/>
                <CheckBox x:Name="ShowBatteryCheck" Content="Show battery" Margin="0,8"/>
                <CheckBox x:Name="ShowVolumeCheck" Content="Show volume" Margin="0,8"/>
                <CheckBox x:Name="ShowClockCheck" Content="Show clock" Margin="0,8"/>
                <TextBlock Text="The Windows taskbar is never modified or hidden by this app." Opacity="0.6" Margin="0,16,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </TabItem>

        <TabItem Header="Performance">
            <StackPanel Margin="12">
                <TextBlock Text="Animation quality" Opacity="0.7" Margin="0,0,0,4"/>
                <ComboBox x:Name="AnimationQualityCombo" Width="200" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Auto (recommended)"/>
                    <ComboBoxItem Content="Full"/>
                    <ComboBoxItem Content="Reduced"/>
                    <ComboBoxItem Content="Minimal"/>
                </ComboBox>
                <TextBlock x:Name="DetectedTierText" Margin="0,16,0,0" Opacity="0.7"/>
            </StackPanel>
        </TabItem>

        <TabItem Header="Startup">
            <StackPanel Margin="12">
                <CheckBox x:Name="StartWithWindowsCheck" Content="Start MacBook Style for Windows with Windows" Margin="0,8"/>
            </StackPanel>
        </TabItem>

        <TabItem Header="Restore">
            <StackPanel Margin="12">
                <TextBlock Text="Restore your original Windows wallpaper and remove all customizations."
                           TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,16"/>
                <Button x:Name="RestoreButton" Content="Restore Original Windows Appearance" Padding="12,8"
                        HorizontalAlignment="Left" Click="RestoreButton_Click"/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
